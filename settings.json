{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "mcp__claude-context__index_codebase",
      "mcp__claude-context__search_code",
      "mcp__claude-context__get_indexing_status",
      "mcp__codegraph__*",
      "Bash(codegraph *)",
      "Edit(./.claude/plans/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push *-f *)",
      "Edit(./.pre-commit-config.yaml)",
      "Edit(./pyproject.toml)",
      "Edit(./mypy.ini)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.coveragerc)",
      "Read(./.env)",
      "Bash(cat .env)"
    ]
  },
  "enabledMcpjsonServers": ["claude-context", "codegraph"],
  "sandbox": {
    "enabled": false
  },
  "theme": "dark",
  "tui": "default",
  "autoCompactWindow": 200000
}
